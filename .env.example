APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,database
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="Laravel Log"
LOG_SLACK_EMOJI=":boom:"

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session Configuration
# Development: Use database for sessions
SESSION_DRIVER=database
# Production: Use Redis for significantly better performance and scalability
# Uncomment the line below for production (required for production optimization):
# SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache Configuration
# Development: Use database for caching
CACHE_STORE=database
CACHE_DRIVER=database
# Production: Use Redis for significantly better performance
# Redis reduces database load and provides faster cache access
# Uncomment the lines below for production:
# CACHE_STORE=redis
# CACHE_DRIVER=redis
CACHE_PREFIX=hospitality_system
# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

MEMCACHED_HOST=127.0.0.1

# Redis Configuration
# Install Redis server and PHP Redis extension (phpredis) before enabling
#
# Installation (Ubuntu/Debian):
#   sudo apt-get install redis-server php-redis
#
# Installation (macOS with Homebrew):
#   brew install redis
#   pecl install redis
#
# For production use, configure Redis for both cache and sessions
# This provides significant performance improvements over database storage
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=hospitality_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Business API Configuration
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# WhatsApp Flows (optional): data endpoint URL and published flow IDs from Meta
# WHATSAPP_FLOWS_DATA_URI=${APP_URL}/api/webhooks/whatsapp-flows/data
# WHATSAPP_FLOW_ID_TRANSFER=
# WHATSAPP_FLOW_ID_LOAN=
# WHATSAPP_FLOW_ID_CARD_BLOCK=
# WHATSAPP_FLOW_ID_AMOUNT_PASSCODE=
# WHATSAPP_FLOW_ID_ADD_BENEFICIARY=
# WHATSAPP_FLOW_ID_RECURRING_TRANSFER=
# WHATSAPP_FLOW_ID_CARDLESS_WITHDRAWAL=
# WHATSAPP_FLOW_ID_LOAN_REPAYMENT=
# WHATSAPP_FLOW_ID_FIXED_DEPOSIT=
# WHATSAPP_FLOW_ID_INVESTMENT=
# WHATSAPP_FLOW_ID_CARD_FREEZE=
# WHATSAPP_FLOW_ID_CARD_UNFREEZE=
# WHATSAPP_FLOW_ID_BOOK_APPOINTMENT=
# WHATSAPP_FLOW_ID_SUPPORT_TICKET=
# WhatsApp attachments (documents/images) storage path, relative to storage/app
# WHATSAPP_ATTACHMENTS_PATH=whatsapp_attachments

# Stripe Payment Gateway Configuration
STRIPE_PUBLIC_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry Error Monitoring (Optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
